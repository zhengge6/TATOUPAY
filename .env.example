# Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
PUBLIC_BASE_URL=https://pay.example.com

# Optional. Leave empty to generate DATA_DIR/.master-key on first startup.
# openssl rand -base64 32
APP_MASTER_KEY=

ALLOW_PRIVATE_CALLBACKS=false
TRUST_PROXY=false

# Optional USDT sidecar (BEpusdt, vendored at ./bepusdt).
# In Docker Compose leave BEPUSDT_BASE_URL unset: compose injects the internal address.
# For local dev start the vendored binary and point here, e.g. http://127.0.0.1:8080.
# Empty hides the method.
BEPUSDT_BASE_URL=
BEPUSDT_API_TOKEN=
BEPUSDT_TRADE_TYPE=usdt.trc20
BEPUSDT_ADDRESS=
